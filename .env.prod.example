# ==============================================================================
# ms-eventomax-catalog — Production Environment Template (.env.prod.example)
# ==============================================================================

# PostgreSQL / Flyway (Schema: catalog)
DB_URL=jdbc:postgresql://<POSTGRES_HOST>:5432/eventomax?currentSchema=catalog
DB_USER=eventomax_prod
DB_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>
DB_SCHEMA=catalog
FLYWAY_CREATE_SCHEMAS=true

# JVM Memory Budget (Container mem_limit: 512m)
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError
